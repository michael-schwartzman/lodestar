{
  "name": "lodestar",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Lodestar — a browser FPS made from scratch. Get into an enrichment site, clear its machine guards, plant the charges, mark it for the strike, and get out.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run lint && npm run build && node --test \"test/*.test.mjs\" \"test/unit/*.test.mjs\" && npm run test:wild && npm run test:second",
    "test:wild": "node --test --test-concurrency=4 --test-timeout=600000 \"test/wild/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:second": "node --test \"test/second/*.test.mjs\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "rayfin": "npx -y @microsoft/rayfin-cli@1.36.2",
    "fabric:deploy": "npm run rayfin -- up",
    "fabric:status": "npm run rayfin -- up status"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@microsoft/rayfin-core": "1.36.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "yaml": "2.9.1"
  }
}
